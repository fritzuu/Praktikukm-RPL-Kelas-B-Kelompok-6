{
  "enabled": true,
  "name": "Auto Commit on Save",
  "description": "Automatically stages and commits changed files whenever a file is saved in the workspace",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "cd \"c:\\KulYeahh\\Sem4\\RPL\\Project\\Praktikum-RPL-Kelas-B-Kelompok-6\" && git add -A && git diff --cached --quiet || git commit -m \"chore: auto-commit saved changes\""
  }
}